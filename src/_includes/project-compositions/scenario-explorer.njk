{% import "project-evidence.njk" as evidence %}
{% set galleryItems = [
  { src: '/assets/images/project-grid-scenarios.svg', alt: 'Three connected grid scenarios', caption: 'System relationship' },
  { src: '/assets/images/project-water-notebook.svg', alt: 'Water path and three design checkpoints', caption: 'Comparison evidence' }
] %}

<div class="project-composition project-composition--scenario-explorer">
  {{ evidence.prose(content) }}

  {% call evidence.diagram('Three named scenarios connect to one shared decision point', 'A reusable diagram primitive keeps meaning in labels as well as color.') %}
    <g class="diagram-lines"><path d="M90 45 360 120M90 120h270M90 195l270-75"/></g>
    <g class="diagram-nodes"><circle cx="90" cy="45" r="24"/><circle cx="90" cy="120" r="24"/><circle cx="90" cy="195" r="24"/><rect x="335" y="88" width="210" height="64" rx="8"/></g>
    <g class="diagram-labels">{% for scenario in scenarioComparison.scenarios %}<text x="130" y="{{ 51 + (loop.index0 * 75) }}">{{ scenario.name }}</text>{% endfor %}<text x="360" y="126">Shared decision</text></g>
  {% endcall %}

  {{ evidence.gallery(galleryItems, 'Scenario evidence gallery') }}

  {{ evidence.dataTable('Static scenario comparison', 'Placeholder scenario comparison table', ['Scenario', 'Reliability signal', 'Planning note'], ['name', 'signal', 'planningNote'], scenarioComparison.scenarios) }}

  <section class="project-visualization" data-project-visualization="{{ visualization.id }}" data-source="{{ visualization.data | url }}" data-state="fallback" role="region" aria-labelledby="visualization-title">
    <p class="eyebrow">Optional Project Visualization</p>
    <h2 id="visualization-title">Placeholder grid scenario comparison</h2>
    <p>This self-contained example enhances only when it approaches the viewport. The complete static comparison stays available.</p>
    <ul class="visualization-fallback">{% for scenario in scenarioComparison.scenarios %}<li><strong>{{ scenario.name }} — {{ scenario.signal }}</strong>: {{ scenario.fallback }}.</li>{% endfor %}</ul>
    <div class="visualization-controls" role="group" hidden aria-label="Choose a scenario to emphasize"></div>
    <p class="visualization-output" aria-live="polite"></p>
    <p class="visualization-status" aria-live="polite"></p>
    <noscript><p>The interactive comparison is unavailable because scripting is disabled. The static scenario list above contains the same information.</p></noscript>
  </section>
</div>
