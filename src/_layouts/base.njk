<!doctype html>
<html lang="en">
  <head>
    {% set pageDescription = description or summary or 'Albert Chang’s Professional Record in community-centered engineering and renewable-energy development.' %}
    {% set pageTitle = title + ' · ' + site.name %}
    {% set canonical = page.url | canonicalUrl %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ pageDescription }}">
    <title>{{ pageTitle }}</title>
    <link rel="canonical" href="{{ canonical }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ canonical }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
    {% if visualization %}<link rel="stylesheet" href="{{ visualization.styles | url }}">{% endif %}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-frame">
      <header class="site-header">
        <a class="wordmark" href="{{ '/' | url }}">Albert Chang</a>
        <nav aria-label="Primary">
          <a href="{{ '/projects/' | url }}">Projects</a>
          <a href="{{ '/education/' | url }}">Education</a>
        </nav>
        <aside class="contact-rail" aria-label="Contact Albert Chang">
          <a href="mailto:{{ site.email }}" aria-label="Email Albert Chang" title="Email Albert Chang">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M3.75 5.75h16.5v12.5H3.75zM4.5 6.5l7.5 6 7.5-6" />
            </svg>
          </a>
          <a href="{{ site.linkedin }}" aria-label="Albert Chang on LinkedIn" title="Albert Chang on LinkedIn" rel="me noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M6.25 8.25v9.5M6.25 5.5v.1M10.25 17.75v-9.5m0 4.25c.75-2.75 6.5-3.25 6.5 1.25v4M3.75 3.75h16.5v16.5H3.75z" />
            </svg>
          </a>
        </aside>
      </header>

      <main id="main-content">
        {% include "visual-motif.njk" %}
        <div class="page-content">{{ content | safe }}</div>
      </main>

      <footer class="site-footer">
        <div><strong>{{ site.name }}</strong><span>{{ site.brandLine }}</span></div>
        <small>© 2026 Albert Chang.</small>
      </footer>
    </div>
    {% if visualization %}<script type="module" src="{{ visualization.module | url }}"></script>{% endif %}
    {% if pageModule %}<script type="module" src="{{ pageModule | url }}"></script>{% endif %}
    {% if page.url == '/' %}<script type="module" src="{{ '/assets/js/visual-motif.js' | url }}"></script>{% endif %}
  </body>
</html>
